{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "evolved-client-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evolved-client-dashboard",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}